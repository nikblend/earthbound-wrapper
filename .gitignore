# --- Xcode / Swift ---
build/
.build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcworkspace/xcuserdata/
.swiftpm/

# Generated by XcodeGen from project.yml
EarthboundWrapper.xcodeproj/
Support/Info.plist

# --- Vendored emulator core (fetched + built by scripts/build-core.sh) ---
Core/lib/
vendor/
dist/

# --- Generated app icon (scripts/make-assets.py) ---
# Four circles and a rounded rectangle; regenerating them costs 40ms, so the
# binary does not need to live here. `make project` depends on `make assets`.
Resources/Assets.xcassets/AppIcon.appiconset/*.png

# --- macOS / editors ---
.DS_Store
*.swp

# --- ROMs / saves: never commit these ---
*.sfc
*.smc
*.fig
*.swc
*.srm
*.state
*.rtc
Roms/

# --- Python ---
__pycache__/
*.pyc

